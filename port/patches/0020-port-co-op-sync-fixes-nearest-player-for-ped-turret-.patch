                 {
                     gNetPlay_7071E8.DeletePlayerFromGroup_521000(player_idx);
                     ShowPlayerLeftMessage_4DB070(player_idx);
-                    if (!player_idx || player_idx == gNetworkPlayerIdx_6F56C8)
+                    // port (D20): the others play on when the host (player 0) leaves; there is no
+                    // DirectPlay session host to lose. The match only ends when this player is dropped.
+                    if (player_idx == gNetworkPlayerIdx_6F56C8)
                     {
                         gPlayerQuit_6F5AEC = 1;
                     }
+                    // a player who left stands still instead of repeating their last inputs
+                    gCurrentNetInputs_6F57D8.field_0_inputs[player_idx].field_0_Inputs = 0;
                 }
             }
             player_idx++;
