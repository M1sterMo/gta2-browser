diff --git a/Source/port_coop.cpp b/Source/port_coop.cpp
new file mode 100644
index 0000000..fef6f8a
--- /dev/null
+++ b/Source/port_coop.cpp
@@ -0,0 +1,45 @@
+// Browser port, co-op (D20): see port_coop.hpp.
+#include "port_coop.hpp"
+
+#include "Game_0x40.hpp"
+#include "Ped.hpp"
+#include "Player.hpp"
+
+Ped* Gta2Port_NearestPlayerPed(Fix16 x, Fix16 y)
+{
+    Ped* best = nullptr;
+    s32 best_d = 0;
+    for (u8 i = 0; gGame_0x40_67E008 && i < GTA2_COUNTOF(gGame_0x40_67E008->field_4_players); ++i)
+    {
+        Player* p = gGame_0x40_67E008->field_4_players[i];
+        Ped* ped = p && p->field_8E_bInUse ? p->field_2C4_player_ped : nullptr;
+        if (!ped)
+        {
+            continue;
+        }
+        s32 dx = (ped->get_cam_x() - x).mValue, dy = (ped->get_cam_y() - y).mValue;
+        dx = dx < 0 ? -dx : dx;
+        dy = dy < 0 ? -dy : dy;
+        const s32 d = dx > dy ? dx : dy;
+        if (!best || d < best_d)
+        {
+            best = ped;
+            best_d = d;
+        }
+    }
+    return best;
+}
+
+Ped* Gta2Port_PlayerPedOfGroup(PedGroup* pGroup)
+{
+    for (u8 i = 0; pGroup && gGame_0x40_67E008 && i < GTA2_COUNTOF(gGame_0x40_67E008->field_4_players); ++i)
+    {
+        Player* p = gGame_0x40_67E008->field_4_players[i];
+        Ped* ped = p && p->field_8E_bInUse ? p->field_2C4_player_ped : nullptr;
+        if (ped && ped->field_164_ped_group == pGroup)
+        {
+            return ped;
+        }
+    }
+    return nullptr;
+}
diff --git a/Source/port_coop.hpp b/Source/port_coop.hpp
new file mode 100644
index 0000000..31ddcaf
--- /dev/null
+++ b/Source/port_coop.hpp
@@ -0,0 +1,15 @@
+#pragma once
+// Browser port, co-op (D20): helpers for game logic that the original wrote for
+// "the player on this computer" (Game_0x40::field_38_orf1). In a lockstep
+// network game every computer must make the same choice, so these pick a player
+// from the game state instead. With one player they return that player.
+#include "fix16.hpp"
+
+class Ped;
+class PedGroup;
+
+// The player ped nearest to (x, y) (Chebyshev distance), or null when no player has a ped.
+Ped* Gta2Port_NearestPlayerPed(Fix16 x, Fix16 y);
+
+// The player ped whose group is pGroup (the player is the group's leader), or null.
+Ped* Gta2Port_PlayerPedOfGroup(PedGroup* pGroup);
diff --git a/Source/winmain.cpp b/Source/winmain.cpp
