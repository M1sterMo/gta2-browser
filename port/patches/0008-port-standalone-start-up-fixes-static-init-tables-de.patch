diff --git a/Source/Object_3C.cpp b/Source/Object_3C.cpp
index 42e3792..b394eb1 100644
--- a/Source/Object_3C.cpp
+++ b/Source/Object_3C.cpp
@@ -289,9 +289,24 @@ Sprite* struct_4::FirstSpriteOfType_5A6CA0(s32 sprite_type)
     return NULL;
 }
 
+#if defined(GTA2_PORT)
+static void PortCheckSprite(const Sprite* p, const char* where)
+{
+    if (p && (p->field_30_sprite_type_enum < 1 || p->field_30_sprite_type_enum > 5))
+    {
+        fprintf(stderr, "GTA2_PORT: %s inserting sprite %p with type %d\n", where, (const void*)p, p->field_30_sprite_type_enum);
+        __builtin_trap();
+    }
+}
+#define PORT_CHECK_SPRITE(p) PortCheckSprite(p, __FUNCTION__)
+#else
+#define PORT_CHECK_SPRITE(p)
+#endif
