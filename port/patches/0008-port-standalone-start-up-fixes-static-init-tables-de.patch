+                fprintf(stderr, "GTA2_PORT: Sprite_18 %p attached sprite %p has type %d (not obj/car/ped), owner sprite %p type %d\n",
+                        (void*)this, (void*)field_0, field_0 ? field_0->field_30_sprite_type_enum : -1, (void*)a2,
+                        a2 ? a2->field_30_sprite_type_enum : -1);
+                __builtin_trap();
+            }
+#endif
             cB4->Update_545720(kFP16Zero_703A38);
         }
     }
