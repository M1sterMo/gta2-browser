 MATCH_FUNC(0x5a6cd0)
 void struct_4::AddSprite_5A6CD0(Sprite* pSprite)
 {
+    PORT_CHECK_SPRITE(pSprite);
     Sprite_18* p18 = gSprite_18_Pool_703B80->Allocate();
     p18->field_0 = pSprite;
     p18->mpNext = this->field_0_p18;
@@ -303,6 +318,7 @@ void struct_4::AddSprite_5A6CD0(Sprite* pSprite)
 MATCH_FUNC(0x5a6d00)
 void struct_4::PushImpactEvent_5A6D00(Sprite* pSprite1, Fix16 x, Fix16 y, Ang16 angle)
