diff --git a/Source/ScrPtr.hpp b/Source/ScrPtr.hpp
new file mode 100644
index 00000000..316cb1ab
--- /dev/null
+++ b/Source/ScrPtr.hpp
@@ -0,0 +1,72 @@
+#ifndef SCR_PTR_HPP
+#define SCR_PTR_HPP
+
+#include <vector>
+#include <unordered_map>
+#include <cstdint>
+#include <cstddef>
+#include "types.hpp"
+
+class ScrPtrManager {
+public:
+    static ScrPtrManager& Instance() {
+        static ScrPtrManager inst;
+        return inst;
+    }
+
+    void Reset() {
+        m_handle_to_ptr.clear();
+        m_handle_to_ptr.push_back(nullptr);
+        m_ptr_to_handle.clear();
+    }
+
+    u32 Store(void* ptr) {
+        if (!ptr) return 0;
+        auto it = m_ptr_to_handle.find(ptr);
+        if (it != m_ptr_to_handle.end()) {
+            return it->second;
+        }
+        u32 handle = static_cast<u32>(m_handle_to_ptr.size());
+        m_handle_to_ptr.push_back(ptr);
+        m_ptr_to_handle[ptr] = handle;
+        return handle;
+    }
+
+    void* Load(u32 handle) const {
+        if (handle == 0 || handle >= m_handle_to_ptr.size()) return nullptr;
+        return m_handle_to_ptr[handle];
+    }
+
+private:
+    ScrPtrManager() {
+        m_handle_to_ptr.push_back(nullptr);
+    }
+    std::vector<void*> m_handle_to_ptr;
+    std::unordered_map<void*, u32> m_ptr_to_handle;
+};
+
+template<typename T>
+struct ScrPtr {
+    u32 m_handle;
+
+    void set(T* ptr) { m_handle = ScrPtrManager::Instance().Store((void*)ptr); }
+    T* get() const { return static_cast<T*>(ScrPtrManager::Instance().Load(m_handle)); }
+
+    ScrPtr& operator=(T* ptr) { set(ptr); return *this; }
+    ScrPtr& operator=(const ScrPtr& o) { m_handle = o.m_handle; return *this; }
+
+    template<typename U>
+    operator U*() const { return reinterpret_cast<U*>(get()); }
+    T* operator->() const { return get(); }
+    T& operator*() const { return *get(); }
+
+    bool operator!() const { return get() == nullptr; }
+    explicit operator bool() const { return get() != nullptr; }
+
+    bool operator==(T* ptr) const { return get() == ptr; }
+    bool operator!=(T* ptr) const { return get() != ptr; }
+    bool operator==(const ScrPtr& o) const { return m_handle == o.m_handle; }
+    bool operator!=(const ScrPtr& o) const { return m_handle != o.m_handle; }
+};
+
+#endif // SCR_PTR_HPP
