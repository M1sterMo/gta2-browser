From: GTA2 port <port@localhost>
Date: Tue, 13 Oct 2026 20:03:37 +1100
Subject: [PATCH 17/25] port: co-op network games in a browser (D20): resumable
 input exchange, input delay, yield while waiting, match end to the shell,
 sync diagnostics

---
 Source/winmain.cpp | 276 ++++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 261 insertions(+), 15 deletions(-)

diff --git a/Source/winmain.cpp b/Source/winmain.cpp
index 6d4defa..f5ad050 100644
--- a/Source/winmain.cpp
+++ b/Source/winmain.cpp
@@ -1479,6 +1479,229 @@ EXPORT void __stdcall do_network_and_local_inputs_4DAF30()
 }
 
 // todo move to another file for ordering
+#ifdef GTA2_PORT
+// Network games in a browser (D20). The original waits for every player's inputs in a loop
+// (Net_Receive_Players_Inputs_4DA9F0), which a page cannot do: messages only arrive between frames.
+// The same steps run here in two halves around that wait, and the wait is polled once per browser
+// frame. The logic is the original's, moved; the received message goes through a local Network_8
+// instead of the original's cast over the adjacent gpInputBuffer / gCurrentInputsBufferSize globals,
+// which are not adjacent in this build.
+extern "C" s32 gGta2PortNetInputDelay; // port/platform/net_web.cpp
+static u32 sPortInputDelay[16];         // this player's inputs waiting for their tick (input delay)
+static u32 sPortInputDelaySlot;
+static u32 sPortNetWaiting;
+static DWORD sPortNetStart;
+static s32 sPortNetRetries;
+static bool sPortNetPending;
+
+static void PortNetReceiveBegin()
+{
+    memcpy(&gNetInputsHistory2_6F5798, &gNetInputsHistory1_6F56E0, sizeof(gNetInputsHistory2_6F5798));
+    memcpy(&gNetInputsHistory1_6F56E0, &gCurrentNetInputs_6F57D8, sizeof(gNetInputsHistory1_6F56E0));
+    sPortNetWaiting = 0;
+    for (u32 i = 0; i < GTA2_COUNTOF(gNetPlay_7071E8.field_758_n2.field_10_players); i++)
+    {
+        if (gNetPlay_7071E8.field_758_n2.field_10_players[i].field_0_in_use && i != gNetworkPlayerIdx_6F56C8)
+        {
+            sPortNetWaiting |= 1 << i;
+        }
+    }
+    sPortNetStart = timeGetTime();
+    sPortNetRetries = 0;
+    gTotalNetworkTime_6F5980 = 0;
+}
+
+// Returns true when every player's inputs for this tick are in (or the game is ending).
+static bool PortNetReceivePoll()
+{
+    const s32 max_retries = bRecordStartTime_6F593C ? 25 : 6;
+    while (sPortNetWaiting)
+    {
+        if (gGame_0x40_67E008->UpdateExitTimer_4B8C20())
+        {
+            return true;
+        }
+        Network_8 msg;
+        s32 player_idx;
+        u32 packet_subtype;
+        if (!gNetPlay_7071E8.ReceiveGameMessage_521890(&msg, &player_idx, &packet_subtype))
+        {
+            break;
+        }
+        const u8* data = static_cast<const u8*>(msg.field_0_data);
+        switch (packet_subtype)
+        {
+            case packet_subtype::StandardPacket_2:
+                switch (data[0])
+                {
+                    case std_packet_subtype::GiveUp_1:
+                    {
+                        s32 who;
+                        memcpy(&who, data + 1, 4);
+                        sPortNetWaiting &= ~(1 << who);
+                        gNetInUsePlayerBits_6F56B8 |= 1 << who;
+                        break;
+                    }
+                    case std_packet_subtype::KeepAlive_2:
+                        sPortNetWaiting &= ~(1 << player_idx);
+                        gNetInUsePlayerBits_6F56B8 |= 1 << player_idx;
+                        break;
+                    case std_packet_subtype::Unknown_3:
+                        sPortNetWaiting = 0;
+                        gPlayerQuit_6F5AEC = 1;
+                        break;
+                    default:
+                        break;
+                }
+                break;
+            case packet_subtype::PlayerInputs_3:
+            {
+                const s32 len = msg.field_4_len < (s32)sizeof(Network_InputData_0x8) ? msg.field_4_len : (s32)sizeof(Network_InputData_0x8);
+                memcpy(&gCurrentNetInputs_6F57D8.field_0_inputs[player_idx], data, len);
+                sPortNetWaiting &= ~(1 << player_idx);
+                if (bDo_sync_check_67D6C1 &&
+                    gCurrentNetInputs_6F57D8.field_0_inputs[player_idx].field_4_rng !=
+                        gCurrentNetInputs_6F57D8.field_0_inputs[gNetworkPlayerIdx_6F56C8].field_4_rng)
+                {
+                    FatalError_4A38C0(Gta2Error::SyncErrorRandom,
+                                      "C:\\Splitting\\Gta2\\Source\\main.cpp",
+                                      822,
+                                      gCurrentNetInputs_6F57D8.field_0_inputs[player_idx].field_4_rng,
+                                      gCurrentNetInputs_6F57D8.field_0_inputs[gNetworkPlayerIdx_6F56C8].field_4_rng);
+                }
+                break;
+            }
+            default:
+                break;
+        }
+    }
+    if (!sPortNetWaiting)
+    {
+        return true;
+    }
+    if (timeGetTime() - sPortNetStart > 1000 && sPortNetRetries >= max_retries)
+    {
+        // Give up on the players that didn't answer, as the original does
+        for (u32 j = 0; j < 6 && sPortNetWaiting; j++)
+        {
+            if (sPortNetWaiting & (1 << j))
+            {
+                sPortNetWaiting &= ~(1 << j);
+                gNetInUsePlayerBits_6F56B8 |= 1 << j;
+                gNetPlay_7071E8.SendGiveUp_521DB0(j);
+                gNetPlayerDropped_6F8470[j] = 1;
+            }
+        }
+        return true;
+    }
+    if (timeGetTime() - sPortNetStart > 1000)
+    {
+        sPortNetStart = timeGetTime();
+        sPortNetRetries++;
+        for (u8 k = 0; k < 6; k++)
+        {
+            if (sPortNetWaiting & (1 << k))
+            {
+                Net_4DA9B0(&gNetInputsHistory1_6F56E0.field_0_inputs[gNetworkPlayerIdx_6F56C8], 1, k);
+                Net_4DA9B0(&gNetInputsHistory2_6F5798.field_0_inputs[gNetworkPlayerIdx_6F56C8], 2, k);
+            }
+        }
+    }
+    return false;
+}
+
+extern "C" void Gta2Port_SyncRecord(); // port/platform/dev_hooks.cpp
+
+// Co-op diagnostics for the shell and tests: where the network game is.
+extern "C" const s32* gta2_port_net_debug()
+{
+    static s32 v[10];
+    v[0] = gGame_0x40_67E008 != 0;
+    v[1] = gFrontend_67DC84 != 0;
+    v[2] = bDoFrontEnd_626B68;
+    v[3] = sPortNetPending;
+    v[4] = gNetworkFrameCounter_6F5868;
+    v[5] = sPortNetRetries;
+    v[6] = sPortNetWaiting;
+    v[7] = gNetworkPlayerIdx_6F56C8;
+    v[8] = gNetInUsePlayerBits_6F56B8;
+    v[9] = gPlayerQuit_6F5AEC;
+    return v;
+}
+
+// do_network_and_local_inputs_4DAF30 up to its input wait. Returns true when the wait is needed.
+static bool PortNetworkInputsBegin()
+{
+    TagGameHudUpdate_4DADA0();
+    gTagGame_6F8450.ExecuteGamemodeTick_516660();
+    if (gGame_0x40_67E008->UpdateExitTimer_4B8C20())
+    {
+        gNetPlay_7071E8.SendKeepAlive_521D20();
+        return false;
+    }
+    if (gNetInUsePlayerBits_6F56B8)
+    {
+        u32 player_idx = 0;
+        do
+        {
+            if ((gNetInUsePlayerBits_6F56B8 & 1) != 0)
+            {
+                Player* pPlayer = gGame_0x40_67E008->get_player_4219E0(player_idx);
+                if (pPlayer && pPlayer->GetInUse_461DB0())
+                {
+                    gNetPlay_7071E8.DeletePlayerFromGroup_521000(player_idx);
+                    ShowPlayerLeftMessage_4DB070(player_idx);
+                    if (!player_idx || player_idx == gNetworkPlayerIdx_6F56C8)
+                    {
+                        gPlayerQuit_6F5AEC = 1;
+                    }
+                }
+            }
+            player_idx++;
+            gNetInUsePlayerBits_6F56B8 >>= 1;
+        } while (gNetInUsePlayerBits_6F56B8);
+    }
+    // Input delay (D20, port/platform/net_web.cpp): today's inputs go out for tick + delay, and this
+    // player plays the ones sent delay ticks ago, as everyone else does.
+    const u32 fresh = gInputRecorder_67F8B0.get_input_bits_4CEAC0();
+    gCurrentNetInputs_6F57D8.field_0_inputs[gNetworkPlayerIdx_6F56C8].field_0_Inputs = fresh;
+    Net_Send_Our_Inputs_4DACB0();
+    if (gGta2PortNetInputDelay > 0)
+    {
+        const u32 slot = sPortInputDelaySlot++ % gGta2PortNetInputDelay;
+        gCurrentNetInputs_6F57D8.field_0_inputs[gNetworkPlayerIdx_6F56C8].field_0_Inputs = sPortInputDelay[slot];
+        sPortInputDelay[slot] = fresh;
+    }
+    Draw_4DA7B0();
+    PortNetReceiveBegin();
+    return true;
+}
+
+// The rest of do_network_and_local_inputs_4DAF30, once the inputs are in.
+static void PortNetworkInputsFinish(bool exchanged)
+{
+    if (exchanged)
+    {
+        memcpy(&gPrevNetInputs_6F5B28, &gCurrentNetInputs_6F57D8, sizeof(gPrevNetInputs_6F5B28));
+    }
+    if (bRecordStartTime_6F593C)
+    {
+        gMatchStartTime_6F5A28 = timeGetTime();
+        bRecordStartTime_6F593C = false;
+    }
+    if (gPlayerQuit_6F5AEC)
+    {
+        gGame_0x40_67E008->ExitGameNoBonus_4B8C00(0, 2);
+    }
+    else
+    {
+        Net_Set_Local_Player_Inputs_4DAD50();
+    }
+    ++gNetworkFrameCounter_6F5868;
+}
+#endif
+
+
 MATCH_FUNC(0x4DA850)
 EXPORT u8 RunGameFrame_4DA850()
 {
@@ -1490,12 +1713,39 @@ EXPORT u8 RunGameFrame_4DA850()
 
     if (bStartNetworkGame_7081F0)
     {
+#ifdef GTA2_PORT
+        if (sPortNetPending)
+        {
+            if (PortNetReceivePoll())
+            {
+                PortNetworkInputsFinish(true);
+                sPortNetPending = false;
+            }
+        }
+        else if (Time >= gMatchStartTime_6F5A28)
+        {
+            bContinue = ExecuteGame_4DA780();
+            Gta2Port_SyncRecord();
+            gMatchStartTime_6F5A28 = Time + gGame_0x40_67E008->GetFrameDurationMs_4B8BB0();
+            sPortNetPending = PortNetworkInputsBegin();
+            if (!sPortNetPending)
+            {
+                PortNetworkInputsFinish(false);
+            }
+            else if (PortNetReceivePoll())
+            {
+                PortNetworkInputsFinish(true);
+                sPortNetPending = false;
+            }
+        }
+#else
         if (Time >= gMatchStartTime_6F5A28)
         {
             bContinue = ExecuteGame_4DA780();
             do_network_and_local_inputs_4DAF30();
             gMatchStartTime_6F5A28 = Time + gGame_0x40_67E008->GetFrameDurationMs_4B8BB0();
         }
+#endif
     }
     else
     {
@@ -2579,8 +2829,14 @@ extern "C" s32 Gta2Port_RunLoopSlice()
     u8& bQuit = sPortQuit_Gta2;
     const u32 presentsBefore = gta2_port_present_count();
     const double sliceStart = gta2_port_now_ms();
-    while (gta2_port_present_count() == presentsBefore && gta2_port_now_ms() - sliceStart < 12.0)
+    for (s32 pass = 0; gta2_port_present_count() == presentsBefore && gta2_port_now_ms() - sliceStart < 12.0; ++pass)
     {
+        // Waiting for the other players' inputs (D20): yield to the browser so their messages can arrive,
+        // instead of polling an inbox that only the browser's event loop can fill.
+        if (pass > 0 && sPortNetPending)
+        {
+            break;
+        }
         if (sPortRestart_Gta2)
         {
             sPortRestart_Gta2 = 0;
@@ -2663,20 +2919,10 @@ extern "C" s32 Gta2Port_RunLoopSlice()
                         {
                             if (bStartNetworkGame_7081F0)
                             {
-                                switch (gGame_0x40_67E008->get_main_state_4D09C0())
-                                {
-                                    case 1:
-                                        DestroyWindow(gHwnd_707F04);
-                                        break;
-
-                                    default:
-                                        state = 7;
-                                        CleanUpInputAndOthers_4DA700();
-                                        bDoFrontEnd_626B68 = 1;
-                                        break;
-                                }
-                                sPortRestart_Gta2 = 1;
-                            continue; // port: go to the beginning
+                                // port: a co-op match ends back in the shell's lobby (D20), not the
+                                // original's network score screen (state 7), which expects DirectPlay
+                                DestroyWindow(gHwnd_707F04);
+                                continue; // go to PeekMessageA (WM_QUIT)
                             }
                             else
                             {
