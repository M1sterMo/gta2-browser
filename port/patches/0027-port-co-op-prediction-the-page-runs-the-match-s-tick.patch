+++ b/Source/Game_0x40.cpp
@@ -72,6 +72,8 @@ extern "C" void Gta2Port_SetFrameLayout(s32 width, s32 hudOffsetX);
 extern "C" void Gta2Port_HudBegin();
 extern "C" void Gta2Port_HudEnd();
 extern "C" void Gta2Port_HudReplay();
+// winmain.cpp (co-op prediction): 1 while a tick nobody sees draws.
