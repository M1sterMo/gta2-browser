From c5d9f307f88c203e53164b6d48d7460f86a07e1d Mon Sep 17 00:00:00 2001
From: GTA2 port <port@localhost>
Date: Tue, 13 Oct 2026 12:41:22 +1100
Subject: [PATCH 12/25] port: restore original data tables the source leaves
 zero (stereo pan curve, AI horn patterns, trailer hitch offsets)

---
 Source/port_static_init.cpp | 46 +++++++++++++++++++++++++++++++++++++
 1 file changed, 46 insertions(+)

diff --git a/Source/port_static_init.cpp b/Source/port_static_init.cpp
index 1dff7b9..37cbbe3 100644
--- a/Source/port_static_init.cpp
+++ b/Source/port_static_init.cpp
@@ -61,6 +61,51 @@ static void RescanMusicDrive()
     }
 }
 
+// Initialised data the original executable carried in its data section but the
+// source declares without values (zero in a standalone build). Values read
+// from the original 9.6F gta2.exe's unpacked memory image under Wine
+// (scripts/refcap/gta2_memdump.c), via the 9.6F counterparts of the functions
+// that use them: ComputePan 0x416E50 (table at 0x591DF8), the car horn update
+// 0x415880 (0x56E820) and SpawnCabAndTrailerHelper 0x40FD40 (0x5D8070, 0x5D7FDC).
+extern u8 gPanTable_61A688[64];
+extern char_type byte_5FE434[8][44];
+extern Fix16_Point gTrailerHitchOffset_66AAC8;
+extern Fix16_Point gTrailerCabOffset_66AAE0;
+
+static void InitOriginalDataTables()
+{
+    // Stereo pan by angle (sound_obj::ComputePan_41A4A0); zero put every sound in the centre.
+    static const u8 kPan[64] = {
+        0, 3, 8, 12, 16, 19, 22, 24, 26, 28, 30, 31, 33, 34, 36, 37,
+        39, 40, 41, 42, 44, 45, 46, 47, 48, 49, 49, 50, 51, 52, 53, 53,
+        54, 55, 55, 56, 56, 57, 57, 58, 58, 58, 59, 59, 59, 60, 60, 61,
+        61, 61, 61, 62, 62, 62, 62, 62, 63, 63, 63, 63, 63, 63, 63, 63};
+    memcpy(gPanTable_61A688, kPan, sizeof(kPan));
+
+    // AI horn rhythms, 8 patterns of 44 ticks (sound_obj::sub_415570); zero meant traffic never honked.
+    static const char* const kHorn[8] = {
+        "00111111111111111000000111111111111111110000",
+        "00111111111111111111111111111111111111111100",
+        "00111111111100001111100011111111111111111110",
+        "00111110011111000111111111100011111111111110",
+        "00111111111000000000000000000000000000000000",
+        "00111000111000000000000000000000000000000000",
+        "00111100001110011100111111000001111111111100",
+        "00111100111110001111110000111111111111100000",
+    };
+    for (u32 p = 0; p < 8; p++)
+    {
+        for (u32 t = 0; t < 44; t++)
+        {
+            byte_5FE434[p][t] = kHorn[p][t] == '1';
+        }
+    }
+
+    // Articulated trucks: hitch behind the cab, trailer centre behind the hitch (Fix16 raw, 1.0 = 16384).
+    gTrailerHitchOffset_66AAC8 = Fix16_Point(Fix16(0), Fix16(-7680, 0));
+    gTrailerCabOffset_66AAE0 = Fix16_Point(Fix16(0), Fix16(12032, 0));
+}
+
 extern "C" void Gta2Port_StaticInit()
 {
     RescanMusicDrive();
@@ -70,4 +115,5 @@ extern "C" void Gta2Port_StaticInit()
     Init_trigonometry_tables();
     Init_Unk_Width_Height_F16_array();
     Init_InputRecorder();
+    InitOriginalDataTables();
 }
-- 
