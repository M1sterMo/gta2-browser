diff --git a/Source/port_modern_camera.cpp b/Source/port_modern_camera.cpp
new file mode 100644
index 0000000..88bec5d
--- /dev/null
+++ b/Source/port_modern_camera.cpp
@@ -0,0 +1,185 @@
+// Browser port: the Modern camera (decision D17), presentation only.
+//
+// The original sets the camera height target to the car's height plus its raw
+// speed whenever the speed is above 1.5 (Camera_0xBC::ApplyCarVelocityCameraOffset_436200),
+// rises fast and falls slowly. Every corner, brake, bump or speed wobble
+// around the threshold re-targets the height, so the view "pumps".
+//
+// The Modern camera filters the canonical height after each camera update:
+//  - it rises towards a higher canonical height smoothly (about 1 s);
+//  - it waits 1.5 s before following a lower one, so a brief brake or corner
+//    changes nothing;
+//  - changes smaller than a deadband are ignored;
+//  - it never rises above the canonical height by more than a ceiling, and
+//    snaps on camera cuts (scripted cameras, teleports).
+// Only the drawn height changes (Game_0x40::Draw swaps it in and restores it).
+// The camera state the game simulates with is never written. When the
+// activation margin is on, the camera boundaries cover the higher of the two
+// heights so nothing spawns or despawns in view (Camera_0xBC::UpdateBoundaries_435B90).
+//
+// Height is filtered per camera update (game ticks), with one state per
+// updated camera so co-op players each get their own.
+#include "Camera.hpp"
+
+#include <math.h>
+
+extern "C" {
+s32 gGta2PortCameraMode = 1;       // 0 = Classic (original), 1 = Modern
+f32 gGta2PortCameraHeightBias = 0; // Modern: added to the drawn height (blocks); options "zoom bias"
+}
+
+namespace
+{
+constexpr f32 kTick = 1.0f / 30.0f; // camera updates run once per game frame (30 per second)
+constexpr f32 kDeadband = 0.3f;     // blocks of height
+constexpr f32 kHoldSeconds = 1.5f;  // wait before following a lower height
+constexpr f32 kOmegaUp = 4.0f;      // critically damped: settles in about 1.2 s
+constexpr f32 kOmegaDown = 2.5f;    // and about 1.9 s going down
+constexpr f32 kMaxAbove = 3.0f;     // never more than this above the canonical height
+constexpr f32 kSnap = 8.0f;         // larger jumps are camera cuts
+constexpr f32 kMaxZ = 14.0f;        // the original's camera height limit (kMaxCamZ_676898)
+
+enum Track : u8
+{
+    kHold,
+    kUp,
+    kDown
+};
+
+struct ModernState
+{
+    const Camera_0xBC* cam;
+    CameraPos canonical; // field_98 after the last update, to recognise copies of this camera
+    f32 z, v, below;
+    Track track;
+    u32 lastUse;
+};
+
+ModernState gStates[16];
+u32 gUseClock = 0;
+
+ModernState* Find(const Camera_0xBC* cam, bool create)
+{
+    ModernState* free = nullptr;
+    for (ModernState& s : gStates)
+    {
+        if (s.cam == cam)
+        {
+            return &s;
+        }
+        if (!free || s.lastUse < free->lastUse)
+        {
+            free = &s;
+        }
+    }
+    if (!create)
+    {
+        return nullptr;
+    }
+    *free = ModernState();
+    free->cam = cam;
+    return free;
+}
+
+bool SamePos(const CameraPos& a, const CameraPos& b)
+{
+    return a.field_0_x == b.field_0_x && a.field_4_y == b.field_4_y && a.field_8_z == b.field_8_z &&
+        a.field_C_zoom == b.field_C_zoom;
+}
+
+void Step(ModernState& s, f32 c)
+{
+    const f32 diff = c - s.z;
+    if (diff > kDeadband)
+    {
+        s.track = kUp;
+        s.below = 0;
+    }
+    else if (diff < -kDeadband)
+    {
+        s.below += kTick;
+        if (s.below >= kHoldSeconds || -diff > kMaxAbove)
+        {
+            s.track = kDown;
+        }
+        else if (s.track == kUp)
+        {
+            s.track = kHold;
+        }
+    }
+    else
+    {
+        s.below = 0;
+        if ((s.track == kUp && diff <= 0) || (s.track == kDown && diff >= 0))
+        {
+            s.track = kHold;
+        }
+    }
+
+    f32 a;
+    if (s.track == kHold)
+    {
+        a = -2.0f * kOmegaUp * s.v; // damp to a stop where it is
+    }
+    else
+    {
+        const f32 w = s.track == kUp ? kOmegaUp : kOmegaDown;
+        a = w * w * diff - 2.0f * w * s.v;
+    }
+    s.v += a * kTick;
+    s.z += s.v * kTick;
+
+    if (s.z > c + kMaxAbove)
+    {
+        s.z = c + kMaxAbove;
+        s.v = 0;
+    }
+    if (s.z > kMaxZ && c <= kMaxZ)
+    {
+        s.z = kMaxZ;
+        s.v = 0;
+    }
+}
+} // namespace
+
+// Called at the end of each camera update, before its boundaries are computed.
+void Gta2Port_ModernCameraTick(Camera_0xBC* cam)
+{
+    ModernState* s = Find(cam, true);
+    s->lastUse = ++gUseClock;
+    const f32 c = cam->field_98_cam_pos2.field_8_z.ToFloat();
+    const bool cut = cam->field_3C_followed_ped_id != 1; // scripted or direct camera
+    if (!gGta2PortCameraMode || cut || s->lastUse == 1 || s->canonical.field_C_zoom == Fix16(0) || fabsf(c - s->z) > kSnap)
+    {
+        s->z = c;
+        s->v = 0;
+        s->below = 0;
+        s->track = kHold;
+    }
+    else
+    {
+        Step(*s, c);
+    }
+    s->canonical = cam->field_98_cam_pos2;
+}
+
+// The height the camera is drawn from: Modern's filtered height (plus the
+// player's bias) for a camera that is, or is a copy of, an updated camera.
+Fix16 Gta2Port_PresentedCameraZ(const Camera_0xBC* cam)
+{
+    const Fix16 canonical = cam->field_98_cam_pos2.field_8_z;
+    if (!gGta2PortCameraMode)
+    {
+        return canonical;
+    }
+    for (const ModernState& s : gStates)
+    {
+        if (s.cam && SamePos(s.canonical, cam->field_98_cam_pos2))
+        {
+            f32 z = s.z + gGta2PortCameraHeightBias;
+            z = z < 1.0f ? 1.0f : z > kMaxZ + 2.0f ? kMaxZ + 2.0f : z;
+            return Fix16(z);
+        }
+    }
+    return canonical;
+}
