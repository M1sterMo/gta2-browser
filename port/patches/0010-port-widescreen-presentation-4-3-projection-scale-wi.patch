+extern "C" void Gta2Port_SetFrameLayout(s32 width, s32 hudOffsetX);
+#endif
+
 DEFINE_GLOBAL_INIT(Fix16, dword_67DECC, Fix16(5), 0x67DECC);
 DEFINE_GLOBAL_INIT(Fix16, dword_67DFB4, dword_67DECC, 0x67DFB4);
 DEFINE_GLOBAL(s32, gNetworkGameSpeed_7071A0, 0x7071A0);
@@ -392,6 +397,10 @@ void Game_0x40::Draw_4B92D0()
 
     pgbh_BeginScene();
 
+#ifdef GTA2_PORT
+    Gta2Port_SetFrameLayout(gViewCamera_676978->field_68_screen_px_width, 0);
+#endif
+
     gpMapRenderer_6F66E4->Draw_4F6A20(); // Note: Also seems to draw sprites
 
     if (!bExplodingScoresOff_67D4FB)
@@ -399,6 +408,9 @@ void Game_0x40::Draw_4B92D0()
         gExplodingScorePool->DrawExplodingScores_5969E0();
     }
 
+#ifdef GTA2_PORT
+    Gta2Port_SetFrameLayout(gViewCamera_676978->field_68_screen_px_width, gViewCamera_676978->PortHudOffsetX());
+#endif
     gHud_2B00_706620->DrawGui_5D6860(); // user
 
     if (bDo_mike_67D5CC)
diff --git a/Source/Hud.cpp b/Source/Hud.cpp
index dbe84d1..563e647 100644
--- a/Source/Hud.cpp
+++ b/Source/Hud.cpp
@@ -118,7 +118,12 @@ static inline void DrawTextScaled_4C7280(const wchar_t* pStr, Fix16 x, Fix16 y,
 static inline void ProjectWorldToScreen_Hud_4B90E0(Camera_0xBC* pCam, Fix16 x, Fix16 y, Fix16 z, Fix16* pOut1, Fix16* pOut2)
 {
     Fix16 scale = kFpOne_7064C4 / ((kFpEight_7064E8 - z) + pCam->field_98_cam_pos2.field_8_z);
+#ifdef GTA2_PORT
+    *pOut1 = (((x - pCam->field_98_cam_pos2.field_0_x) * pCam->field_60.x) * scale) +
+        Fix16(pCam->field_70_screen_px_center_x - pCam->PortHudOffsetX());
+#else
     *pOut1 = (((x - pCam->field_98_cam_pos2.field_0_x) * pCam->field_60.x) * scale) + Fix16(pCam->field_70_screen_px_center_x);
+#endif
     *pOut2 = (((y - pCam->field_98_cam_pos2.field_4_y) * pCam->field_60.x) * scale) + Fix16(pCam->field_74_screen_px_center_y);
 }
 
diff --git a/Source/MapRenderer.cpp b/Source/MapRenderer.cpp
index 40f965c..077d535 100644
--- a/Source/MapRenderer.cpp
+++ b/Source/MapRenderer.cpp
@@ -3554,7 +3554,12 @@ void MapRenderer::Draw_4F6A20()
             Fix16 layer_column_width = layer_row_width * kScreenAspectRatio_6F638C;
 
             // compute x boundary
+#ifdef GTA2_PORT
+            // Widescreen: cover the extra width (presentation only).
+            Fix16 half_x = layer_row_width * gViewCamera_676978->field_68_screen_px_width / gViewCamera_676978->PortRefWidth() / 2;
+#else
             Fix16 half_x = layer_row_width / 2;
+#endif
             s32 min_x = (gViewCamera_676978->field_98_cam_pos2.field_0_x - half_x).ToInt();
             s32 max_x = (gViewCamera_676978->field_98_cam_pos2.field_0_x + half_x).ToInt();
 
diff --git a/Source/SpriteGrid_400.cpp b/Source/SpriteGrid_400.cpp
index 753f428..3fce54e 100644
--- a/Source/SpriteGrid_400.cpp
+++ b/Source/SpriteGrid_400.cpp
@@ -62,8 +62,17 @@ static inline s32 Clamp(s32 value, s32 min, s32 max)
 MATCH_FUNC(0x477a40)
 void SpriteGrid_400::DrawSpritesClipped_477A40()
 {
+#ifdef GTA2_PORT
+    // Widescreen: existing sprites are drawn in the extra width. Without the activation margin only
+    // this draw pass widens; the boundaries that drive spawning and activation keep their 4:3 size.
+    const Camera_0xBC* pCam = gViewCamera_676978;
+    const Fix16 extra = gGta2PortWideActivation ? Fix16(0) : pCam->PortWideExtraX();
+    const s32 left = Clamp((pCam->field_78_boundaries_non_neg.field_0_left - kFpOne_679084 - extra).ToInt(), 0, 255);
+    const s32 right_val = Clamp((kFpOneAndHalf_678F80 + pCam->field_78_boundaries_non_neg.field_4_right + extra).ToInt(), 0, 255);
+#else
     const s32 left = Clamp((gViewCamera_676978->field_78_boundaries_non_neg.field_0_left - kFpOne_679084).ToInt(), 0, 255);
     const s32 right_val = Clamp((kFpOneAndHalf_678F80 + gViewCamera_676978->field_78_boundaries_non_neg.field_4_right).ToInt(), 0, 255);
+#endif
     const s32 top_val = Clamp((gViewCamera_676978->field_78_boundaries_non_neg.field_8_top - kFpOne_679084).ToInt(), 0, 255);
     const s32 bottom_val = Clamp((kFpOneAndHalf_678F80 + gViewCamera_676978->field_78_boundaries_non_neg.field_C_bottom).ToInt(), 0, 255);
 
