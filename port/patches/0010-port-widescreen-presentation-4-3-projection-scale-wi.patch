From 0c1a632c6d37603fd01c674ddcea2b5bc865fde1 Mon Sep 17 00:00:00 2001
From: GTA2 port <port@localhost>
Date: Tue, 13 Oct 2026 11:48:49 +1100
Subject: [PATCH 10/25] port: widescreen presentation (4:3 projection scale,
 wider tile and sprite ranges, centred HUD box, optional activation margin)

---
 Source/Camera.cpp         | 21 +++++++++++++++++++++
 Source/Camera.hpp         | 29 +++++++++++++++++++++++++++++
 Source/Game_0x40.cpp      | 12 ++++++++++++
 Source/Hud.cpp            |  5 +++++
 Source/MapRenderer.cpp    |  5 +++++
 Source/SpriteGrid_400.cpp |  9 +++++++++
 6 files changed, 81 insertions(+)

diff --git a/Source/Camera.cpp b/Source/Camera.cpp
index 7303340..506a5c5 100644
--- a/Source/Camera.cpp
+++ b/Source/Camera.cpp
@@ -371,11 +371,25 @@ s32 Camera_0xBC::IsCoordsPosVisible_435A70(Fix16 x, Fix16 y, Fix16 z)
 MATCH_FUNC(0x435B90)
 void Camera_0xBC::UpdateBoundaries_435B90()
 {
+#ifdef GTA2_PORT
+    // Widescreen: scale from the 4:3 width of the same height, so a wider screen shows more world
+    // horizontally instead of zooming in.
+    field_60.x = Fix16(PortRefWidth()) * field_98_cam_pos2.field_C_zoom;
+#else
     field_60.x = Fix16(field_68_screen_px_width) * field_98_cam_pos2.field_C_zoom;
+#endif
     field_60.y = Fix16(640) * field_98_cam_pos2.field_C_zoom;
 
     Fix16 v = (dword_676838 + field_98_cam_pos2.field_8_z) * (kOne_67681C / field_98_cam_pos2.field_C_zoom) * dword_67671C;
 
+#ifdef GTA2_PORT
+    const Fix16 v_y = v;
+    if (gGta2PortWideActivation)
+    {
+        v += PortWideExtraX();
+    }
+#endif
+
     field_78_boundaries_non_neg.field_0_left = field_98_cam_pos2.field_0_x - v;
     if (field_78_boundaries_non_neg.field_0_left < kZero_676818)
     {
@@ -396,6 +410,9 @@ void Camera_0xBC::UpdateBoundaries_435B90()
         field_78_boundaries_non_neg.field_4_right = kMaxMapCoord_67668C;
     }
 
+#ifdef GTA2_PORT
+    v = v_y;
+#endif
     v *= dword_6768E0;
 
     field_78_boundaries_non_neg.field_8_top = field_98_cam_pos2.field_4_y - v;
@@ -581,7 +598,11 @@ void Camera_0xBC::SetScreenSize_4361B0(u32 x_pos, u32 y_pos)
     field_60.x = Fix16(-1);
     field_60.y = Fix16(-1);
 
+#ifdef GTA2_PORT
+    field_A8_ui_scale = Fix16(y_pos) / 480; // same as x / 640 at 4:3
+#else
     field_A8_ui_scale = Fix16(x_pos) / 640;
+#endif
 }
 
 
diff --git a/Source/Camera.hpp b/Source/Camera.hpp
index 487652c..4520059 100644
--- a/Source/Camera.hpp
+++ b/Source/Camera.hpp
@@ -33,6 +33,13 @@ struct WorldRect
     Fix16 field_C_bottom;
 };
 
+#ifdef GTA2_PORT
+// Presentation activation margin (D07/D17): when set, a wide screen widens the camera boundaries the
+// simulation uses (spawning, on-screen and despawn checks) to the visible width, so nothing pops in
+// or out in view. A recorded gameplay deviation; 0 keeps the canonical 4:3 rectangle. Port layer.
+extern "C" s32 gGta2PortWideActivation;
+#endif
+
 class Camera_0xBC
 {
   public:
@@ -68,6 +75,28 @@ class Camera_0xBC
     EXPORT void HandlePanning_436710(char_type a2, char_type a3, char_type a4, char_type a5);
     EXPORT void ResetPanning_436830();
     EXPORT void ApplyZOffsetToScreenPosition_436860(Ped* a2, Fix16& x_pos, Fix16& y_pos, Fix16 z_pos);
+#ifdef GTA2_PORT
+    // Widescreen presentation: the screen is wider than the 4:3 reference box of the same height.
+    s32 PortRefWidth() const
+    {
+        return field_6C_screen_px_height * 4 / 3;
+    }
+    // Horizontal offset of the centred 4:3 box (HUD space) inside the wide screen.
+    s32 PortHudOffsetX() const
+    {
+        return (field_68_screen_px_width - PortRefWidth()) / 2;
+    }
+    // World width (each side, at ground level) that a wide screen shows beyond the 4:3 view.
+    Fix16 PortWideExtraX() const
+    {
+        if (field_68_screen_px_width <= PortRefWidth() || field_98_cam_pos2.field_C_zoom <= Fix16(0))
+        {
+            return Fix16(0);
+        }
+        return (field_98_cam_pos2.field_8_z + Fix16(8)) / field_98_cam_pos2.field_C_zoom *
+            (field_68_screen_px_width - PortRefWidth()) / PortRefWidth() / 2;
+    }
+#endif
     EXPORT Camera_0xBC(); // 4368E0
     EXPORT ~Camera_0xBC(); // empty 4369E0
     EXPORT void SetTarget_4397D0(Fix16 a2, Fix16 a3, Fix16 a4, Fix16 a5);
diff --git a/Source/Game_0x40.cpp b/Source/Game_0x40.cpp
