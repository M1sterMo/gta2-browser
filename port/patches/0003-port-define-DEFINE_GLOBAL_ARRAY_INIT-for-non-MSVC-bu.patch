From: GTA2 port <port@localhost>
Date: Tue, 13 Oct 2026 10:13:18 +1100
Subject: [PATCH 03/25] port: define DEFINE_GLOBAL_ARRAY_INIT for non-MSVC
 builds

---
 Source/Function.hpp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/Source/Function.hpp b/Source/Function.hpp
index b09cf6b..2d23e5e 100644
--- a/Source/Function.hpp
+++ b/Source/Function.hpp
@@ -179,7 +179,8 @@ void __stdcall LogFuncAddr(u32 codeAddr, s32 mode);
     #define DEFINE_GLOBAL_INIT(type, name, value, addr) type name = value
 
     #define DEFINE_GLOBAL_ARRAY(type, name, size, addr) type name[size]
-//#define DEFINE_GLOBAL_ARRAY_INIT(type, name, size, addr, ...)  type name[size] = { __VA_ARGS__ }
+    // Browser port: the array initialiser is passed through COMMA as in the MSVC branch.
+    #define DEFINE_GLOBAL_ARRAY_INIT(type, name, size, addr, va_args) type name[size] = {va_args}
 
     #define EXTERN_GLOBAL(type, name) extern type name
     #define EXTERN_GLOBAL_ARRAY(type, name, size) extern type name[size]
